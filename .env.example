# BACKEND_PORT yalnızca ana makinedeki (host) portu belirler; konteyner içinde backend 8000'i dinler.
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8000
DATA_DIR=/data
MODEL_CACHE_DIR=/models
IMAGE_MODEL=clip-ViT-B-32
TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
FACE_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
FACE_BLUR_ENABLED=true
FACE_SCORE_THRESHOLD=0.6
MAX_UPLOAD_MB=8
MAX_IMAGE_SIDE=1024
# Açılmadan önce reddedilen piksel sınırı (piksel bombasına karşı; telefon fotoğrafları 12–50 MP).
MAX_IMAGE_PIXELS=50000000
# İstek gövdesi sınırı = MAX_UPLOAD_MB + bu pay (MB); aşan istek gövde okunmadan 413 alır.
UPLOAD_FORM_OVERHEAD_MB=1
# Konteynerdeki /tmp (RAM) boyutu; MAX_UPLOAD_MB büyütülürse bunu da büyütün (yalnızca compose).
TMP_SIZE=128m
TORCH_NUM_THREADS=4
MATCH_HIGH=0.37
MATCH_MEDIUM=0.31
# Görsel-görsel skorları için ayrı eşikler (Faz 8, docs/EVAL.md): yalnızca görselle aramada ve görselli
# kayıp bildirimi eşleşmesinde kullanılır; metin+görsel aramada metin eşikleriyle yarı yarıya harmanlanır.
MATCH_IMAGE_HIGH=0.87
MATCH_IMAGE_MEDIUM=0.80
# Otomatik kategori etiketinin güveni bunun altındaysa ilan "diğer" kategorisine düşer.
TAG_MIN_CONFIDENCE=0.35
# Örnek değerdir ve backend tarafından YOK SAYILIR (ADMIN_REJECT_WEAK_TOKENS=true iken change-me, ornek-* ve kısa tokenlar yetki vermez).
# Gerçek token üretin: openssl rand -hex 16. Boş bırakılırsa yönetici uçları kapalıdır (403).
ADMIN_TOKEN=change-me
# Teslim noktası başına yönetici tokenı (JSON, tek satır). Örnek değerlerdir; gerçek tokenları yalnızca kendi .env dosyanıza yazın.
# Bir nokta tokenı yalnızca o noktaya teslim edilen ilanları yönetir; ADMIN_TOKEN tüm noktaları yönetir.
ADMIN_POINT_TOKENS={"Öğrenci İşleri":"ornek-token-ogrenci-isleri","Kütüphane Danışma":"ornek-token-kutuphane"}
# true: change-me, ornek-* ve ADMIN_TOKEN_MIN_LEN'den kısa tokenlar yok sayılır. false yalnızca yerel prototip içindir
# (o zaman yukarıdaki örnek tokenlar çalışır ve port 8000'e erişen herkes ilan silebilir).
ADMIN_REJECT_WEAK_TOKENS=true
ADMIN_TOKEN_MIN_LEN=12
LOG_LEVEL=INFO
# Yerel OCR ile kişisel veri sansürü (Faz 7A). OCR_ENABLED=false yalnızca geliştirme içindir:
# kapalıyken görseldeki metin tabanlı kişisel veriler sansürlenmez.
OCR_ENABLED=true
OCR_LANGS=tur+eng
OCR_MAX_SIDE=1600
OCR_TIMEOUT_S=8
# Yalnızca marka/model etiketi çıkarmada kullanılır; kişisel veri sansürü güvenden bağımsız bütün kelimelere bakar.
OCR_MIN_CONF=30
OMP_THREAD_LIMIT=1
# Arama: ilan metni (başlık + açıklama + etiketler) ağırlığı ve marka/model etiket eşleşme puanı
SEARCH_TEXT_WEIGHT=0.1
TAG_BONUS=0.05
TAG_BONUS_MAX=0.10
