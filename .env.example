# BACKEND_PORT yalnızca ana makinedeki (host) portu belirler; konteyner içinde backend 8000'i dinler.
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:8000
DATA_DIR=/data
MODEL_CACHE_DIR=/models
IMAGE_MODEL=clip-ViT-B-32
TEXT_MODEL=sentence-transformers/clip-ViT-B-32-multilingual-v1
FACE_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx
FACE_BLUR_ENABLED=true
FACE_SCORE_THRESHOLD=0.6
MAX_UPLOAD_MB=8
MAX_IMAGE_SIDE=1024
TORCH_NUM_THREADS=4
MATCH_HIGH=0.315
MATCH_MEDIUM=0.255
MATCH_IMAGE_MEDIUM=0.80
# Örnek değerdir; gerçek kullanımda değiştirin. Boş bırakılırsa yönetici uçları kapalıdır (403).
ADMIN_TOKEN=change-me
LOG_LEVEL=INFO
# Yerel OCR ile kişisel veri sansürü (Faz 7A). OCR_ENABLED=false yalnızca geliştirme içindir:
# kapalıyken görseldeki metin tabanlı kişisel veriler sansürlenmez.
OCR_ENABLED=true
OCR_LANGS=tur+eng
OCR_MAX_SIDE=1600
OCR_TIMEOUT_S=8
OCR_MIN_CONF=30
OMP_THREAD_LIMIT=1
# Arama: ilan metni (başlık + açıklama + etiketler) ağırlığı ve marka/model etiket eşleşme puanı
SEARCH_TEXT_WEIGHT=0.0
TAG_BONUS=0.05
TAG_BONUS_MAX=0.10
